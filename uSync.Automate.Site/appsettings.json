{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Umbraco.Automate.Core": "Debug",
        "uSync.Automate": "Debug"
      }
    }
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "c4baf8e4-8526-43c4-b469-6436b593a07f",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true,
        "InstallMissingDatabase": true,
        "UnattendedUserName": "Administrator",
        "UnattendedUserEmail": "admin@usync-automate.local",
        "UnattendedUserPassword": "VerifyRoundTrip123!"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "K9UoPgZNxBcqD4Za2iWPJhLnAAeUmaiz83jFq7Ab0U4p991fSfBHC/+7O6Xb+EbKghouTyOiJx4V/y76NyXZGQ=="
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite",
    "umbracoAutomateDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoAutomateDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "uSync": {
    "Automate": {
      "DisableAutomatePush": false,
      "IncludeSensitiveSettings": false,
      "IgnoreCanvasState": false,
      "ApplyPublishedStatus": true
    }
  }
}
